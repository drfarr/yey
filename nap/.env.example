# Required
ANTHROPIC_API_KEY=sk-ant-...

# Share links + rate limits. Add the Upstash Redis integration on Vercel and these are set for you.
# Without them nap uses process memory, which resets on every cold start.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
NAP_PUBLIC_URL=https://nap.example.com   # absolute URL for social cards; defaults to the Vercel production URL
NAP_LIMIT_PER_MINUTE=10                  # naps per IP per minute
NAP_LIMIT_PER_DAY=40                     # naps per IP per day
PORT=3000                                # local dev server only
