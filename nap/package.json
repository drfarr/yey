{
  "name": "nap",
  "version": "0.2.0",
  "private": true,
  "description": "Paste anything. Find out what you could have slept through.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsx scripts/build.ts",
    "nap": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.136.0",
    "@upstash/redis": "^1.39.0",
    "@vercel/og": "0.11.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vercel/node": "^25.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^5.0.5"
  }
}
